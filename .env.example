# === ค่าที่จำเป็น (Discord) ===
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_server_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# === ค่าที่ Render จะตั้งให้อัตโนมัติ (ไม่ต้องใส่เอง) ===
# PORT=10000
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# === ค่าที่ตั้งเองได้ (ไม่บังคับ) ===
# ใช้แทน RENDER_EXTERNAL_URL ถ้าอยากกำหนด URL ping เอง
# PING_URL=https://your-service-name.onrender.com

# ความถี่ในการ self-ping หน่วยเป็นมิลลิวินาที (ค่าเริ่มต้น 4 นาที = 240000)
# PING_INTERVAL_MS=240000
